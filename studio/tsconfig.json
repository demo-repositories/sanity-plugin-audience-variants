{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "Preserve",
    "moduleDetection": "force",
    "isolatedModules": true,
    "jsx": "preserve",
    "noUncheckedSideEffectImports": false,
    "incremental": true,
    // Type-check against the plugin's source, not its built dist (see sanity.cli.ts).
    "paths": {
      "sanity-plugin-audience-variants": ["../packages/sanity-plugin-audience-variants/src/index.ts"],
      "sanity-plugin-audience-variants/resolve": [
        "../packages/sanity-plugin-audience-variants/src/exports/resolve.ts"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
